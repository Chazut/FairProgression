<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <AssemblyName>FairProgression</AssemblyName>
    <Version>1.1.0</Version>
    <RootNamespace>FairProgression</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <DeployOnBuild Condition="'$(DeployOnBuild)' == ''">false</DeployOnBuild>
  </PropertyGroup>

  <!-- Copy config folder into Release output -->
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <None Include="..\..\config\**\*.*">
      <Link>config\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>config\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </None>
  </ItemGroup>

  <!-- SPT 4.1.6 server references (SPT_DIR points to SPT_Runtime) -->
  <ItemGroup Condition="'$(SPT_DIR)' != ''">
    <Reference Include="SPTarkov.Server.Core">
      <HintPath>$(SPT_DIR)\SPTarkov.Server.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.DI">
      <HintPath>$(SPT_DIR)\SPTarkov.DI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.Common">
      <HintPath>$(SPT_DIR)\SPTarkov.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPT.Server">
      <HintPath>$(SPT_DIR)\SPT.Server.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SemanticVersioning">
      <HintPath>$(SPT_DIR)\SemanticVersioning.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Require SPT_DIR -->
  <Target Name="EnsureSptDirProvided" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(SPT_DIR)' == ''" Text="SPT_DIR must be set (path to SPT server DLLs) to build this project." />
    <Error Condition="'$(SPT_DIR)' != '' and !Exists('$(SPT_DIR)\SPTarkov.Server.Core.dll')" Text="SPT_DIR must point to the SPT 4.1.6 SPT_Runtime folder containing the server DLLs." />
  </Target>

  <!-- Optional deployment; regular builds leave the installed mod and config untouched. -->
  <PropertyGroup>
    <ModDeployDir>$(SPT_DIR)\user\mods\FairProgression</ModDeployDir>
  </PropertyGroup>

  <Target Name="DeployMod" AfterTargets="Build" Condition="'$(DeployOnBuild)' == 'true' and Exists('$(ModDeployDir)')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModDeployDir)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="[FairProgression] Deployed DLL to $(ModDeployDir)" />
  </Target>

  <Target Name="DeployModAssets" AfterTargets="Build" Condition="'$(DeployOnBuild)' == 'true' and Exists('$(ModDeployDir)')">
    <ItemGroup>
      <ConfigFiles Include="..\..\config\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ConfigFiles)" DestinationFiles="@(ConfigFiles->'$(ModDeployDir)\config\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
