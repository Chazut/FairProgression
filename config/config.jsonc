{
  // FairProgression — Quest XP Rebalancer for SPT 4.0
  // Automatically scales quest XP rewards to preserve the vanilla progression curve
  // when modded quests are installed.

  // Scaling mode:
  //   "scale_all"         — reduce ALL quest XP proportionally (vanilla + modded)
  //                         so the total XP per level bracket matches vanilla exactly.
  //   "scale_modded_only" — only reduce modded quest XP, leave vanilla rewards untouched.
  //                         Modded quests absorb the full reduction.
  "mode": "scale_all",

  // Level brackets for XP budget calculation.
  //   "trader" — auto-compute from vanilla trader loyalty level requirements.
  //              Creates brackets aligned with LL2/LL3/LL4 unlock phases:
  //              [13, 20, 32, 42] (based on actual trader minLevel values)
  //   [5, 10, ...] — manual JSON array of bracket upper bounds.
  // Quests estimated above the last bracket are left untouched.
  "level_brackets": "trader",

  // Minimum scaling coefficient. Prevents quest XP from being reduced below this ratio.
  // e.g., 0.25 means quest XP will never drop below 25% of its original value.
  "min_coefficient": 0.25,

  // When true, prints a detailed dashboard in server logs showing:
  //   - Detected modded quests and their source
  //   - XP budget per bracket (vanilla vs actual vs scaled)
  //   - Per-quest XP changes
  "enable_dashboard": true,

  // Buff under-rewarded quests: when a quest's objectives are significantly harder
  // than its XP reward suggests, increase the XP to match the difficulty.
  // Uses the vanilla median XP for the estimated difficulty level as the target.
  "buff_under_rewarded": true,

  // Minimum level gap (difficultyLevel - xpLevel) to trigger a buff.
  "buff_gap_threshold": 5,

  // When true, calculates and logs everything but does NOT modify any quest rewards.
  // Use this to preview the impact before applying changes.
  "dry_run": false,

  // Enable verbose per-quest logging (each quest's XP before/after).
  "verbose": false
}
